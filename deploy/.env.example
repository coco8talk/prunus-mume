# Copy to .env before running docker compose. .env itself is git-ignored /
# kept out of version control — these are local-dev-only defaults, simple and
# shared on purpose since every port is bound to 127.0.0.1 only.

# --- core ---
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=redis

# --- db ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# --- msa ---
# Nacos inner-API identity headers (server-to-server), not client login.
# NACOS_AUTH_TOKEN must be base64-encoded and decode to >=32 chars.
NACOS_AUTH_IDENTITY_KEY=nacos-server
NACOS_AUTH_IDENTITY_VALUE=nacos-server
NACOS_AUTH_TOKEN=TG9jYWxEZXZOYWNvc1NlY3JldEtleTAxMjM0NTY3ODlBQkNERUZH
SENTINEL_DASHBOARD_USER=sentinel
SENTINEL_DASHBOARD_PASSWORD=sentinel

# --- sre ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ZIPKIN_MYSQL_ROOT_PASSWORD=zipkin
