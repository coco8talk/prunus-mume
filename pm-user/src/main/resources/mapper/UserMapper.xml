<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coco8talk.pm.user.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.coco8talk.pm.user.model.entity.User">
            <id property="id" column="id" />
            <result property="userAccount" column="user_account" />
            <result property="userPassword" column="user_password" />
            <result property="unionId" column="union_id" />
            <result property="mpOpenId" column="mp_open_id" />
            <result property="userName" column="user_name" />
            <result property="userAvatar" column="user_avatar" />
            <result property="userRole" column="user_role" />
            <result property="userProfile" column="user_profile" />
            <result property="phoneNumber" column="phone_number" />
            <result property="email" column="email" />
            <result property="grade" column="grade" />
            <result property="workExperience" column="work_experience" />
            <result property="expertiseDirection" column="expertise_direction" />
            <result property="vipNumber" column="vip_number" />
            <result property="vipCode" column="vip_code" />
            <result property="vipExpireTime" column="vip_expire_time" />
            <result property="createTime" column="create_time" />
            <result property="editTime" column="edit_time" />
            <result property="updateTime" column="update_time" />
            <result property="deleted" column="deleted" />
            <result property="shareCode" column="share_code" />
            <result property="inviteUserId" column="invite_user_id" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_account,user_password,union_id,mp_open_id,user_name,
        user_avatar,user_role,user_profile,phone_number,email,
        grade,work_experience,expertise_direction,vip_number,vip_code,
        vip_expire_time,create_time,edit_time,update_time,deleted,
        share_code,invite_user_id
    </sql>
    <update id="updateAvatarById">
        update user
        set user_avatar = #{avatarUrl}
        where id = #{avatarCosKey}
    </update>
</mapper>
